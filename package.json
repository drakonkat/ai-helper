{
  "name": "@drakonkat/ai-helper",
  "version": "1.1.1",
  "description": "Zero-config background service manager, auto-discovery daemon & dashboard launcher for AI agent ecosystems (pxpipe, ocx, agentmemory, headroom)",
  "main": "src/index.js",
  "module": "src/index.js",
  "type": "module",
  "bin": {
    "aih": "bin/cli.js",
    "ai-helper": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "scripts/build.js",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drakonkat/ai-helper.git"
  },
  "bugs": {
    "url": "https://github.com/drakonkat/ai-helper/issues"
  },
  "homepage": "https://github.com/drakonkat/ai-helper#readme",
  "scripts": {
    "start": "node ./bin/cli.js",
    "dev": "node ./bin/cli.js",
    "test": "bun test test/aih.test.js test/metrics.test.js test/discovery.test.js test/tui-pipeline.test.js test/tui-versions.test.js test/versions.test.js && node --test test/proxy.test.js",
    "build": "bun run scripts/build.js",
    "install-bin": "bun run scripts/install-bin.js"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "pxpipe",
    "ocx",
    "agentmemory",
    "headroom",
    "mcp",
    "npx",
    "service-manager",
    "dashboard",
    "developer-tools"
  ],
  "author": "Mauro",
  "license": "MIT",
  "dependencies": {
    "gpt-tokenizer": "3.4.0",
    "pxpipe-proxy": "0.13.2",
    "ws": "^8.21.3"
  }
}
